DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=universe
DB_SSL=false

WINDMILL_BASE_URL=https://your-windmill-instance.com
WINDMILL_TOKEN=your-windmill-token
WINDMILL_WORKSPACE=claw

# Local Claude proxy (OpenAI-compatible) used to build supplement/medication dossiers.
# Anthropic Messages-API proxy base (the server appends /v1/messages).
# LLM_API_KEY is optional — the self-hosted proxy doesn't validate it.
LLM_API_URL=https://claude-code.tail322ce1.ts.net:4003
LLM_API_KEY=
# Must be a Claude model: opus / sonnet / haiku, or a full id like
# claude-sonnet-4-6. (The old qwen shim names are rejected.) These are
# optional — the server defaults all three tasks to sonnet.
LLM_MODEL_DOSSIER=sonnet
LLM_MODEL_INSIGHTS=sonnet
LLM_MODEL_CHAT=sonnet
